#!/usr/bin/env bash

set -euo pipefail

: "${MILL_DATABASE_URL:?MILL_DATABASE_URL must be reachable from kind Pods}"
: "${MILL_OUTPUT_ROOT_URI:?MILL_OUTPUT_ROOT_URI is required}"
: "${AWS_REGION:?AWS_REGION is required for the local S3 deployment}"

readonly JOB_IMAGE="${MILL_JOB_IMAGE:-mill/job-service:dev}"
readonly EXECUTOR_IMAGE="${MILL_EXECUTOR_IMAGE:-mill/executor:dev}"
readonly CONTEXT="kind-mill"
readonly SYSTEM_NAMESPACE="mill-system"
readonly WORKLOAD_NAMESPACE="mill-workloads"
temporary_directory=""

cleanup() {
	if [[ -n "${temporary_directory}" && -d "${temporary_directory}" ]]; then
		rm -rf -- "${temporary_directory}"
	fi
}

fail() {
	printf 'deploy-local-control-plane: %s\n' "$*" >&2
	exit 1
}

require_command() {
	command -v "$1" >/dev/null 2>&1 || fail "$1 is required"
}

reject_newline() {
	local name="$1"
	local value="$2"
	[[ "${value}" != *$'\n'* ]] || fail "${name} must not contain a newline"
}

write_environment_file() {
	local destination="$1"
	shift
	: > "${destination}"
	while (( $# > 0 )); do
		reject_newline "$1" "$2"
		printf '%s=%s\n' "$1" "$2" >> "${destination}"
		shift 2
	done
}

apply_secret_from_file() {
	local namespace="$1"
	local name="$2"
	local source="$3"
	kubectl --context "${CONTEXT}" -n "${namespace}" create secret generic "${name}" \
		--from-env-file="${source}" --dry-run=client -o yaml |
		kubectl --context "${CONTEXT}" apply -f - >/dev/null
}

main() {
	[[ "$#" -eq 0 ]] || fail "does not accept arguments"
	[[ "${MILL_OUTPUT_ROOT_URI}" == s3://* ]] ||
		fail "this Pod deployment requires an s3:// output root"
	if [[ -n "${AWS_ACCESS_KEY_ID:-}" || -n "${AWS_SECRET_ACCESS_KEY:-}" || -n "${AWS_SESSION_TOKEN:-}" ]]; then
		[[ -n "${AWS_ACCESS_KEY_ID:-}" && -n "${AWS_SECRET_ACCESS_KEY:-}" ]] ||
			fail "AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY must be configured together"
	fi
	for command_name in docker kind kubectl mktemp; do
		require_command "${command_name}"
	done
	docker info >/dev/null 2>&1 || fail "cannot reach the Docker daemon"
	kubectl --context "${CONTEXT}" get nodes >/dev/null

	MILL_JOB_IMAGE="${JOB_IMAGE}" MILL_EXECUTOR_IMAGE="${EXECUTOR_IMAGE}" \
		./scripts/build-control-plane-images
	kind load docker-image "${JOB_IMAGE}" "${EXECUTOR_IMAGE}" --name mill
	kubectl --context "${CONTEXT}" apply -f deploy/kubernetes/local/namespaces-rbac.yaml >/dev/null

	temporary_directory="$(mktemp -d)"
	write_environment_file "${temporary_directory}/job.env" \
		MILL_DATABASE_URL "${MILL_DATABASE_URL}" \
		MILL_OUTPUT_ROOT_URI "${MILL_OUTPUT_ROOT_URI}" \
		AWS_REGION "${AWS_REGION}" \
		MILL_S3_ENDPOINT "${MILL_S3_ENDPOINT:-}" \
		AWS_ACCESS_KEY_ID "${AWS_ACCESS_KEY_ID:-}" \
		AWS_SECRET_ACCESS_KEY "${AWS_SECRET_ACCESS_KEY:-}" \
		AWS_SESSION_TOKEN "${AWS_SESSION_TOKEN:-}"
	apply_secret_from_file "${SYSTEM_NAMESPACE}" mill-job-config "${temporary_directory}/job.env"

	local credentials_secret=""
	if [[ -n "${AWS_ACCESS_KEY_ID:-}" || -n "${AWS_SECRET_ACCESS_KEY:-}" || -n "${AWS_SESSION_TOKEN:-}" ]]; then
		credentials_secret=mill-workload-storage
		write_environment_file "${temporary_directory}/workload.env" \
			AWS_ACCESS_KEY_ID "${AWS_ACCESS_KEY_ID}" \
			AWS_SECRET_ACCESS_KEY "${AWS_SECRET_ACCESS_KEY}" \
			AWS_SESSION_TOKEN "${AWS_SESSION_TOKEN:-}"
		apply_secret_from_file "${WORKLOAD_NAMESPACE}" "${credentials_secret}" "${temporary_directory}/workload.env"
	fi
	write_environment_file "${temporary_directory}/executor.env" \
		MILL_WORKLOAD_S3_REGION "${MILL_WORKLOAD_S3_REGION:-${AWS_REGION}}" \
		MILL_WORKLOAD_S3_ENDPOINT "${MILL_WORKLOAD_S3_ENDPOINT:-${MILL_S3_ENDPOINT:-}}" \
		MILL_WORKLOAD_S3_CREDENTIALS_SECRET "${credentials_secret}"
	apply_secret_from_file "${SYSTEM_NAMESPACE}" mill-executor-config "${temporary_directory}/executor.env"

	kubectl --context "${CONTEXT}" apply -f deploy/kubernetes/local/control-plane.yaml >/dev/null
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" set image \
		deployment/mill-job-service "job-service=${JOB_IMAGE}" >/dev/null
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" set image \
		deployment/mill-executor "executor=${EXECUTOR_IMAGE}" >/dev/null
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" rollout restart \
		deployment/mill-job-service deployment/mill-executor >/dev/null
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" rollout status \
		deployment/mill-job-service --timeout=120s
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" rollout status \
		deployment/mill-executor --timeout=120s

	printf '\nMill control plane is running in %s.\n' "${CONTEXT}"
	kubectl --context "${CONTEXT}" -n "${SYSTEM_NAMESPACE}" get deployments,pods,service
	printf '\nInspect the API locally:\n'
	printf '  kubectl --context %s -n %s port-forward service/mill-job 8080:8080\n' \
		"${CONTEXT}" "${SYSTEM_NAMESPACE}"
}

trap cleanup EXIT
main "$@"
