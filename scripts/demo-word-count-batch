#!/usr/bin/env bash

set -euo pipefail

failure_mode=none
restart_coordinator=false
if [[ $# -eq 2 && "$1" == --failure && ( "$2" == once || "$2" == always ) ]]; then
	failure_mode="$2"
elif [[ $# -eq 1 && "$1" == --restart-coordinator ]]; then
	restart_coordinator=true
elif [[ $# -ne 0 ]]; then
	printf 'Usage: %s [--failure once|always | --restart-coordinator]\n' "$0" >&2; exit 1
fi
cd "$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
for required in go docker kind kubectl initdb pg_ctl psql curl jq mktemp wc tr tar cmp basename grep; do
	command -v "${required}" >/dev/null || { printf 'Missing command: %s\n' "${required}" >&2; exit 1; }
done
parallelism="${MILL_PARALLELISM:-3}"
[[ "${parallelism}" == 2 || "${parallelism}" == 3 ]] || { printf 'This demo supports MILL_PARALLELISM=2 or 3.\n' >&2; exit 1; }
port="${MILL_DEMO_PORT:-18080}"
[[ "${port}" =~ ^[0-9]+$ ]] && (( port > 1024 && port < 65536 )) || { printf 'Invalid MILL_DEMO_PORT\n' >&2; exit 1; }
docker info >/dev/null
kubectl --context kind-mill get node mill-control-plane >/dev/null
[[ "$(initdb --version)" == *' 18.'* ]] || { printf 'PostgreSQL 18 tools are required.\n' >&2; exit 1; }

run_directory="$(mktemp -d /tmp/mill-batch.XXXXXXXX)"
node_directory="/var/local/$(basename "${run_directory}" | tr '[:upper:]' '[:lower:]' | tr '.' '-')"
server_pid=""
postgres_started=false
job_id=""
cleanup() {
	local status=$?
	if [[ -n "${server_pid}" ]]; then
		kill -TERM "${server_pid}" 2>/dev/null || true
		if ! wait "${server_pid}"; then
			printf 'Mill did not exit cleanly; inspect server.log\n' >&2
			status=1
		fi
	fi
	if [[ "${postgres_started}" == true ]]; then
		pg_ctl -D "${run_directory}/postgres" -m fast -w stop >/dev/null || true
	fi
	if (( status != 0 )); then
		printf '\nDemo failed; inspect %s/server.log and %s/postgres.log\n' "${run_directory}" "${run_directory}" >&2
		if [[ -n "${job_id}" ]]; then
			kubectl --context kind-mill -n default get jobs,pods -l "mill.dev/job-id=${job_id}" || true
		fi
	fi
	exit "${status}"
}
trap cleanup EXIT
printf 'Local files: %s\nNode files: %s\n' "${run_directory}" "${node_directory}"
mkdir "${run_directory}/input" "${run_directory}/output" "${run_directory}/socket"
go run ./examples/word-count/generate --output "${run_directory}/input/records.jsonl"
go build -o "${run_directory}/mill" ./cmd/mill
image=mill/word-count:dev
dockerfile=examples/word-count/cmd/word-count/Dockerfile
if [[ "${failure_mode}" != none || "${restart_coordinator}" == true ]]; then
	image=mill/word-count-fault:dev
	dockerfile=examples/word-count/cmd/fault-injection/Dockerfile
fi
docker build --file "${dockerfile}" --tag "${image}" .
kind load docker-image "${image}" --name mill

docker exec mill-control-plane mkdir -p /var/local
docker exec mill-control-plane mkdir "${node_directory}"
docker exec mill-control-plane chmod 0755 "${node_directory}"
docker exec mill-control-plane mkdir "${node_directory}/input" "${node_directory}/output"
docker exec mill-control-plane chmod 0755 "${node_directory}/input" "${node_directory}/output"
docker exec -i mill-control-plane tee "${node_directory}/input/records.jsonl" < "${run_directory}/input/records.jsonl" >/dev/null
docker exec mill-control-plane chmod 0444 "${node_directory}/input/records.jsonl"
docker exec mill-control-plane chown 65532:65532 "${node_directory}/output"

# A private Unix-socket-only database avoids changing a developer's existing
# PostgreSQL instance. Its files are kept after the demo stops its processes.
initdb -D "${run_directory}/postgres" --username=mill_demo --auth-local=trust --auth-host=reject --encoding=UTF8 --no-locale > "${run_directory}/initdb.log"
pg_ctl -D "${run_directory}/postgres" -l "${run_directory}/postgres.log" -o "-k ${run_directory}/socket -h ''" -w start
postgres_started=true
psql "postgresql://mill_demo@/postgres?host=${run_directory}/socket" -v ON_ERROR_STOP=1 -c 'CREATE DATABASE mill' >/dev/null
export MILL_DATABASE_URL="postgresql://mill_demo@/mill?host=${run_directory}/socket"
for migration in migrations/*.sql; do
	psql "${MILL_DATABASE_URL}" -v ON_ERROR_STOP=1 -f "${migration}" >/dev/null
done
export MILL_HTTP_ADDR="127.0.0.1:${port}" MILL_PARALLELISM="${parallelism}"
export MILL_OUTPUT_ROOT_URI="file://${run_directory}/output"
export MILL_EXECUTOR=kubernetes MILL_KUBE_CONTEXT=kind-mill MILL_KUBE_NAMESPACE=default MILL_KUBE_NODE=mill-control-plane
export MILL_LOCAL_ROOT="${run_directory}" MILL_NODE_ROOT="${node_directory}"
start_mill() {
	printf '\n--- starting Mill process ---\n' >> "${run_directory}/server.log"
	"${run_directory}/mill" >> "${run_directory}/server.log" 2>&1 &
	server_pid=$!
	local ready=false
	for _ in {1..60}; do
		kill -0 "${server_pid}" 2>/dev/null || { printf 'Mill exited; inspect server.log\n' >&2; return 1; }
		if curl -fsS "http://${MILL_HTTP_ADDR}/readyz" >/dev/null 2>&1; then ready=true; break; fi
		sleep 0.5
	done
	[[ "${ready}" == true ]] || { printf 'Mill did not become ready\n' >&2; return 1; }
}
start_mill

workload_mode="${failure_mode}"
if [[ "${restart_coordinator}" == true ]]; then workload_mode=delay; fi
jq -n --arg uri "file://${run_directory}/input/records.jsonl" --arg image "${image}" --arg mode "${workload_mode}" \
	'{executable:{image:$image,args:(if $mode == "none" then [] else [$mode] end)},input:{uri:$uri}}' > "${run_directory}/submission.json"
curl -fsS "http://${MILL_HTTP_ADDR}/jobs" -H 'Content-Type: application/json' -H 'Idempotency-Key: word-count-batch' \
	--data-binary "@${run_directory}/submission.json" > "${run_directory}/job.json"
job_id="$(jq -er '.id' "${run_directory}/job.json")"
expected_tasks="$(jq -er '.progress.total' "${run_directory}/job.json")"
printf '\nMill job: %s\nWatch Pods: kubectl --context kind-mill -n default get pods -l mill.dev/job-id=%s -w\n' "${job_id}" "${job_id}"
peak=0
finished=false
coordinator_restarted=false
deadline=$((SECONDS + 180))
while (( SECONDS < deadline )); do
	curl -fsS "http://${MILL_HTTP_ADDR}/jobs/${job_id}" > "${run_directory}/status.json"
	state="$(jq -r '.state' "${run_directory}/status.json")"
	running="$(jq -r '.progress.running' "${run_directory}/status.json")"
	(( running <= parallelism )) || { printf 'Concurrency limit exceeded\n' >&2; exit 1; }
	if (( running > peak )); then peak=${running}; fi
	jq -c '{state,progress}' "${run_directory}/status.json"
	if [[ "${restart_coordinator}" == true && "${coordinator_restarted}" == false && "${running}" == "${parallelism}" ]]; then
		durable_running="$(psql "${MILL_DATABASE_URL}" -XAt -v ON_ERROR_STOP=1 -c "
			SELECT count(*) FROM attempts a JOIN tasks t ON t.id = a.task_id
			WHERE t.job_id = '${job_id}'::uuid AND a.state = 'running' AND a.external_id IS NOT NULL")"
		if [[ "${durable_running}" == "${parallelism}" ]]; then
			psql "${MILL_DATABASE_URL}" -XAt -v ON_ERROR_STOP=1 -v job_id="${job_id}" > "${run_directory}/attempts-before-crash.json" <<'SQL'
SELECT json_agg(snapshot ORDER BY shard_index)
FROM (
    SELECT t.shard_index, t.id::text AS task_id, a.id::text AS attempt_id,
        a.attempt_number, a.external_id, a.state
    FROM tasks t JOIN attempts a ON a.task_id = t.id
    WHERE t.job_id = :'job_id'::uuid
) snapshot;
SQL
			kubectl --context kind-mill -n default get jobs -l "mill.dev/job-id=${job_id}" -o json \
				| jq '[.items[] | {name:.metadata.name,uid:.metadata.uid}] | sort_by(.name)' \
				> "${run_directory}/kubernetes-before-crash.json"
			jq -e --argjson expected "${parallelism}" 'length == $expected and all(.[]; .attempt_number == 1 and .state == "running" and (.external_id | length > 0))' \
				"${run_directory}/attempts-before-crash.json" >/dev/null
			jq -e --argjson expected "${parallelism}" 'length == $expected' "${run_directory}/kubernetes-before-crash.json" >/dev/null

			printf '\nCrashing Mill PID %s while %s attempts are running...\n' "${server_pid}" "${parallelism}"
			crashed_pid="${server_pid}"
			server_pid=""
			kill -KILL "${crashed_pid}"
			if wait "${crashed_pid}" 2>/dev/null; then
				printf 'Expected the killed Mill process to exit unsuccessfully\n' >&2; exit 1
			fi
			if curl -fsS "http://${MILL_HTTP_ADDR}/readyz" >/dev/null 2>&1; then
				printf 'Mill still answers after SIGKILL\n' >&2; exit 1
			fi
			psql "${MILL_DATABASE_URL}" -XAt -v ON_ERROR_STOP=1 -c 'SELECT 1' >/dev/null
			kubectl --context kind-mill -n default get jobs -l "mill.dev/job-id=${job_id}" -o json \
				| jq '[.items[] | {name:.metadata.name,uid:.metadata.uid}] | sort_by(.name)' \
				> "${run_directory}/kubernetes-without-coordinator.json"
			cmp "${run_directory}/kubernetes-before-crash.json" "${run_directory}/kubernetes-without-coordinator.json"

			printf 'PostgreSQL and Kubernetes survived. Restarting Mill...\n'
			start_mill
			psql "${MILL_DATABASE_URL}" -XAt -v ON_ERROR_STOP=1 -v job_id="${job_id}" > "${run_directory}/attempts-after-restart.json" <<'SQL'
SELECT json_agg(snapshot ORDER BY shard_index)
FROM (
    SELECT t.shard_index, t.id::text AS task_id, a.id::text AS attempt_id,
        a.attempt_number, a.external_id, a.state
    FROM tasks t JOIN attempts a ON a.task_id = t.id
    WHERE t.job_id = :'job_id'::uuid
) snapshot;
SQL
			kubectl --context kind-mill -n default get jobs -l "mill.dev/job-id=${job_id}" -o json \
				| jq '[.items[] | {name:.metadata.name,uid:.metadata.uid}] | sort_by(.name)' \
				> "${run_directory}/kubernetes-after-restart.json"
			cmp "${run_directory}/attempts-before-crash.json" "${run_directory}/attempts-after-restart.json"
			cmp "${run_directory}/kubernetes-before-crash.json" "${run_directory}/kubernetes-after-restart.json"
			coordinator_restarted=true
			printf 'Recovered the same attempt IDs and Kubernetes UIDs; no duplicate was created.\n\n'
		fi
	fi
	if [[ "${state}" == completed || ( "${state}" == failed && "${running}" == 0 ) ]]; then finished=true; break; fi
	sleep 0.5
done
[[ "${finished}" == true ]] || { printf 'Timed out waiting for the batch\n' >&2; exit 1; }
if [[ "${restart_coordinator}" == true && "${coordinator_restarted}" != true ]]; then
	printf 'The coordinator restart was never triggered\n' >&2; exit 1
fi

# Preserve durable evidence before stopping the private database. Waiting tasks
# do not consume slots; each retry must start at least five seconds after failure.
psql "${MILL_DATABASE_URL}" -XAt -v ON_ERROR_STOP=1 -v job_id="${job_id}" > "${run_directory}/attempts.json" <<'SQL'
SELECT json_agg(history ORDER BY shard_index, attempt_number)
FROM (
    SELECT t.shard_index, t.id AS task_id, t.state AS task_state,
        a.id AS attempt_id, a.attempt_number, a.state, a.failure_message,
        a.created_at, a.finished_at,
        a.attempt_number = 1 OR a.created_at >= previous.finished_at + interval '5 seconds' AS retry_delay_ok
    FROM tasks t JOIN attempts a ON a.task_id = t.id
    LEFT JOIN attempts previous ON previous.task_id = a.task_id AND previous.attempt_number = a.attempt_number - 1
    WHERE t.job_id = :'job_id'::uuid
) history;
SQL
jq -e 'all(.[]; .attempt_number <= 3 and .retry_delay_ok == true)' "${run_directory}/attempts.json" >/dev/null
printf '\nAttempt history (shard, attempt, state, task state):\n'
jq -r '.[] | [.shard_index, .attempt_number, .state, .task_state] | @tsv' "${run_directory}/attempts.json"
printf 'Attempt history: %s/attempts.json\n' "${run_directory}"
printf 'Inspect: kubectl --context kind-mill -n default get jobs,pods -l mill.dev/job-id=%s\n' "${job_id}"
printf 'Remove Jobs/Pods when finished: kubectl --context kind-mill -n default delete jobs -l mill.dev/job-id=%s\n' "${job_id}"

if [[ "${failure_mode}" != none ]]; then
	mapfile -t failed_attempts < <(jq -r '.[] | select(.state == "failed") | .attempt_id' "${run_directory}/attempts.json")
	for attempt in "${failed_attempts[@]}"; do
		kubectl --context kind-mill -n default logs "job/mill-${attempt}" > "${run_directory}/failure-${attempt}.log"
		grep -q 'injected failure:' "${run_directory}/failure-${attempt}.log"
	done
fi

if [[ "${failure_mode}" == always ]]; then
	jq -e '.state == "failed" and .progress.failed == 1 and .progress.running == 0 and (has("results") | not)' "${run_directory}/status.json" >/dev/null
	jq -e '[.[] | select(.shard_index == 0)] | length == 3 and all(.[]; .state == "failed" and .task_state == "failed")' "${run_directory}/attempts.json" >/dev/null
	jq -e 'all(.[] | select(.shard_index != 0); .attempt_number == 1 and .state == "completed")' "${run_directory}/attempts.json" >/dev/null
	printf '\nPASS: shard 0 exhausted exactly three attempts; job failed, no successful job result published.\nObserved peak running tasks: %s\nJob status: %s/status.json\n' "${peak}" "${run_directory}"
	exit 0
fi
jq -e --argjson tasks "${expected_tasks}" '.state == "completed" and .progress.total == $tasks and .progress.completed == $tasks and (.results | length) == $tasks' "${run_directory}/status.json" >/dev/null
if [[ "${failure_mode}" == once ]]; then
	jq -e --argjson tasks "${expected_tasks}" 'length == $tasks + 1 and ([.[] | select(.shard_index == 0) | .state] == ["failed", "completed"]) and all(.[] | select(.shard_index != 0); .attempt_number == 1 and .state == "completed")' "${run_directory}/attempts.json" >/dev/null
else
	jq -e --argjson tasks "${expected_tasks}" 'length == $tasks and all(.[]; .attempt_number == 1 and .state == "completed")' "${run_directory}/attempts.json" >/dev/null
fi

docker exec mill-control-plane tar -C "${node_directory}/output" -cf - . | tar -C "${run_directory}/output" -xf -
mapfile -t partials < <(jq -r '.results[].uri | sub("^file://"; "")' "${run_directory}/status.json")
go run ./examples/word-count/cmd/merge "${partials[@]}" > "${run_directory}/counts.jsonl"
input_size="$(wc -c < "${run_directory}/input/records.jsonl")"
go run ./examples/word-count/cmd/word-count --job-id "${job_id}" --task-id local-baseline --shard-index 0 \
	--input-uri "file://${run_directory}/input/records.jsonl" --input-start-byte 0 --input-end-byte "${input_size}" \
	--output-uri "file://${run_directory}/baseline.jsonl" --
cmp "${run_directory}/baseline.jsonl" "${run_directory}/counts.jsonl"
if [[ "${restart_coordinator}" == true ]]; then
	printf '\nPASS: Mill recovered the same running attempts and Kubernetes Jobs after SIGKILL.\n'
	printf 'Recovery snapshots: %s/attempts-before-crash.json and %s/kubernetes-before-crash.json\n' "${run_directory}" "${run_directory}"
fi
printf '\nPASS: %s task outputs merged; exact match with the full-input local count.\nObserved peak running tasks: %s\nFinal counts: %s/counts.jsonl\nJob status: %s/status.json\n' "${expected_tasks}" "${peak}" "${run_directory}" "${run_directory}"
